<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex justify-content-center align-items-center vh-100">

  <div class="card shadow-lg text-center" style="max-width: 600px; border-radius: 15px;">
    <!-- Static Error Image -->
    <img 
      src="/images/error.jpg" 
      class="card-img-top" 
      alt="Error" 
      style="object-fit: cover; height: 250px; border-top-left-radius: 15px; border-top-right-radius: 15px;"
    />

    <div class="card-body">
      <!-- Error Status Code -->
      <h1 class="card-title text-danger">
        <%= err.statusCode || 500 %> Error
      </h1>

      <!-- Error Message -->
      <p class="card-text">
        <%= err.message || "Something went wrong! Please try again later." %>
      </p>

      <!-- Back Button -->
      <a href="/listings" class="btn btn-primary mt-3">Go Back Home</a>
    </div>
  </div>

</body>
</html>


