<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
      <div class="card shadow-sm border-0 rounded-3">

        <% 
          // ✅ Image handling logic (string, object, or missing)
          let imageUrl;
          if (listing.image) {
            if (typeof listing.image === "string") imageUrl = listing.image;
            else if (listing.image.url) imageUrl = listing.image.url;
          } else {
            imageUrl = "https://via.placeholder.com/600x300?text=No+Image";
          }
        %>

        <!-- 🖼️ Listing Image -->
       <img src="<%= listing.imageUrl %>" class="img-fluid rounded mb-3" alt="<%= listing.title %>" style="height:250px; width:100%; object-fit:cover;">


        <!-- 📋 Card Body -->
        <div class="card-body">
          <h4 class="fw-bold"><%= listing.title %></h4>
          <p class="text-muted mb-1"><%= listing.description %></p>
          <p class="mb-1 fw-semibold text-success">PKR Rs <%= listing.price.toLocaleString("en-PK") %></p>
          <p class="mb-1"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>

          <% if (listing.owner) { %>
            <p class="text-secondary mb-3">
              <i class="fa-regular fa-user"></i> Posted by: <%= listing.owner.username %>
            </p>
          <% } %>

          <!-- ✏️ Edit/Delete Buttons -->
          <% if (currentUser && listing.owner && listing.owner.equals(currentUser._id)) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this listing?');">
                Delete
              </button>
            </form>
          <% } %>

          <!-- 📝 Leave a Review Form -->
          <hr>
          <h5 class="mt-4">Leave a Review</h5>
          <form action="/listings/<%= listing._id %>/reviews" method="POST">
            <!-- ⭐ Rating -->
            <div class="mb-3">
              <label for="rating" class="form-label">Rating</label>
              <div class="star-rating">
                <% for (let i = 5; i >= 1; i--) { %>
                  <input type="radio" id="star<%= i %>" name="review[rating]" value="<%= i %>">
                  <label for="star<%= i %>" title="<%= i %> stars">
                    <i class="fa-solid fa-star"></i>
                  </label>
                <% } %>
              </div>
              <style>
                .star-rating {
                  direction: rtl;
                  display: flex;
                  gap: 5px;
                  justify-content: start;
                }
                .star-rating input {
                  display: none;
                }
                .star-rating label {
                  color: #ccc;
                  font-size: 1.5rem;
                  cursor: pointer;
                  transition: color 0.2s;
                }
                .star-rating input:checked ~ label,
                .star-rating label:hover,
                .star-rating label:hover ~ label {
                  color: #f6c600;
                }
              </style>
            </div>

            <!-- 💬 Comments -->
            <div class="mb-3">
              <label for="body" class="form-label">Comments</label>
              <textarea 
                name="review[body]" 
                id="body" 
                rows="3" 
                class="form-control" 
                placeholder="Write your review here..."></textarea>
            </div>

            <!-- 🚀 Submit -->
            <button type="submit" class="btn btn-primary w-100">Submit Review</button>
          </form>

          <!-- 💬 Show Reviews -->
          <hr>
          <h5 class="mt-4">Reviews</h5>
          <% if (listing.reviews.length === 0) { %>
            <p class="text-muted">No reviews yet. Be the first to leave one!</p>
          <% } else { %>
            <ul class="list-group">
              <% for (let review of listing.reviews) { %>
                <li class="list-group-item d-flex justify-content-between align-items-start">
                  <div>
                    <% 
                      const rating = review.rating && review.rating > 0 ? review.rating : 1; // default 1 star
                    %>
                    <!-- ⭐ Star Display -->
                    <div class="mb-1">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= rating) { %>
                          <i class="fa-solid fa-star text-warning"></i>
                        <% } else { %>
                          <i class="fa-regular fa-star text-warning"></i>
                        <% } %>
                      <% } %>
                    </div>

                    <p class="mb-0"><%= review.body %></p>
                    <% if (review.author) { %>
                      <small class="text-muted">— <%= review.author.username %></small>
                    <% } %>
                  </div>

                  <!-- ❌ Delete Button -->
                  <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button type="submit" class="btn btn-sm btn-outline-danger ms-3">
                        Delete
                      </button>
                    </form>
                  <% } %>
                </li>
              <% } %>
            </ul>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</div>



















