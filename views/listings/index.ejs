<% layout('layouts/boilerplate') %>

<div class="container my-1">
  <style>
    #filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .filter {
      text-align: center;
      margin-right: 1.5rem;
      opacity: 0.7;
      transition: all 0.3s ease;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
      transform: translateY(-2px);
    }

    .filter p {
      font-size: 0.8rem;
      margin-top: 4px;
    }

    .toggle-wrapper {
      display: flex;
      align-items: center;
      font-size: 0.9rem;
    }

    .toggle-label {
      margin-left: 0.5rem;
      font-weight: 500;
    }

    .toggle-input {
      width: 45px;
      height: 22px;
      appearance: none;
      background-color: #ccc;
      border-radius: 50px;
      position: relative;
      cursor: pointer;
      outline: none;
      transition: background-color 0.3s;
    }

    .toggle-input::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      top: 2px;
      left: 2px;
      background-color: white;
      transition: transform 0.3s;
    }

    .toggle-input:checked {
      background-color: #4CAF50;
    }

    .toggle-input:checked::before {
      transform: translateX(23px);
    }
  </style>

  <!-- 🔹 FILTER BAR -->
  <div class="container my-4">
  <!-- 🔹 Filter Bar -->
  <div id="filter-bar" class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div id="filters" class="d-flex flex-wrap align-items-center">
      <div class="filter"><i class="fa-solid fa-fire"></i><p>Trending</p></div>
      <div class="filter"><i class="fa-solid fa-bed"></i><p>Rooms</p></div>
      <div class="filter"><i class="fa-solid fa-mountain-city"></i><p>Iconic Cities</p></div>
      <div class="filter"><i class="fa-solid fa-mountain"></i><p>Mountains</p></div>
      <div class="filter"><i class="fa-brands fa-fort-awesome"></i><p>Castles</p></div>
      <div class="filter"><i class="fa-solid fa-person-swimming"></i><p>Pools</p></div>
      <div class="filter"><i class="fa-solid fa-campground"></i><p>Camping</p></div>
      <div class="filter"><i class="fa-solid fa-cow"></i><p>Farm</p></div>
      <div class="filter"><i class="fa-regular fa-snowflake"></i><p>Arctic</p></div>
    </div>

    <div class="toggle-wrapper d-flex align-items-center">
      <input type="checkbox" id="taxToggle" class="toggle-input me-2">
      <label for="taxToggle" class="toggle-label">Display total after taxes</label>
    </div>
  </div>

  <!-- 🔹 Listings Grid -->
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    <% if (listings && listings.length > 0) { %>
      <% listings.forEach(listing => { %>
        <div class="col">
          <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
              
              <!-- ✅ IMAGE FIX -->
              <img
                src="<%= listing.image?.url || listing.image || 'https://via.placeholder.com/600x300?text=No+Image' %>"
                alt="<%= listing.title || 'Listing Image' %>"
                class="card-img-top"
                style="height:280px;object-fit:cover;transition:transform 0.3s ease;"
                loading="lazy"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'"
              >

              <div class="card-body">
                <h5 class="card-title fw-semibold mb-1">
                  <%= listing.title || 'Untitled Listing' %>
                </h5>
                <p class="text-success fw-semibold mb-1 price-text" data-price="<%= listing.price || 0 %>">
                  ₨ <%= listing.price ? listing.price.toLocaleString('en-PK') : 'N/A' %> / night
                </p>
                <p class="small text-secondary mb-0">
                  <i class="fa-solid fa-location-dot me-1"></i>
                  <%= listing.location || 'Unknown Location' %>, 
                  <%= listing.country || 'N/A' %>
                </p>
              </div>
            </a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="text-center text-muted my-5">
        <i class="fa-solid fa-circle-exclamation fa-2x mb-3"></i>
        <h5>No listings found yet.</h5>
        <p class="small">Try adding a new one!</p>
      </div>
    <% } %>
  </div>
</div>

<!-- 🔹 GST Toggle Script -->
<script>
  const toggle = document.getElementById('taxToggle');
  const prices = document.querySelectorAll('.price-text');

  toggle.addEventListener('change', function () {
    prices.forEach(priceEl => {
      const basePrice = parseFloat(priceEl.dataset.price);
      if (isNaN(basePrice) || basePrice === 0) return;

      if (this.checked) {
        const gstPrice = Math.round(basePrice * 1.18);
        priceEl.innerHTML = `₨ ${gstPrice.toLocaleString('en-PK')} (incl. GST 18%) / night`;
      } else {
        priceEl.innerHTML = `₨ ${basePrice.toLocaleString('en-PK')} / night`;
      }
    });
  });
</script>

























