<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <h1 class="text-center fw-bold mb-4">🌍 Explore All Listings</h1>

  <!-- Debug: confirm EJS is receiving listings -->
  <pre style="background:#f8f9fa;padding:10px;border-radius:6px;">
<%= JSON.stringify(listings, null, 2) %>
  </pre>

  <% if (listings && listings.length > 0) { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mt-3">
      <% listings.forEach(listing => { 
        let imgSrc;

        if (listing.image) {
          if (typeof listing.image === "string") imgSrc = listing.image;
          else if (listing.image.url) imgSrc = listing.image.url;
          else imgSrc = "https://via.placeholder.com/600x300?text=No+Image";
        } else {
          imgSrc = "https://via.placeholder.com/600x300?text=No+Image";
        }
      %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
              <img 
                src="<%= imgSrc %>" 
                class="card-img-top" 
                alt="<%= listing.title %>" 
                style="object-fit: cover; height: 200px;"
              >
              <div class="card-body">
                <h5 class="card-title fw-bold"><%= listing.title %></h5>
                <p class="text-muted mb-1"><%= listing.location %>, <%= listing.country %></p>
                <p class="fw-semibold">₨ <%= listing.price.toLocaleString('en-PK') %> / night</p>
              </div>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center mt-5">
      <h4>No listings found 😢</h4>
      <a href="/listings/new" class="btn btn-success mt-3">Create New Listing</a>
    </div>
  <% } %>
</div>




























